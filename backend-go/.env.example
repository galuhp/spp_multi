# =============================================================================
# Konfigurasi backend Go E-SPP
# Salin ke shared/api.env pada server (provision-go.sh melakukannya otomatis).
# =============================================================================

APP_ENV=production
GIN_MODE=release
# APP_PORT sengaja tidak diisi: unit systemd blue/green menetapkan
# 8081 (blue) / 8082 (green). Untuk lokal, default-nya 8080.
LOG_LEVEL=info

# Wajib minimal 32 karakter. Buat dengan: openssl rand -base64 48
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_TTL=12h

# mysql | sqlite
DB_DRIVER=mysql

# MySQL/MariaDB: user:password@tcp(host:port)/database?charset=utf8mb4&parseTime=True&loc=Local
# parseTime=True wajib untuk kolom waktu GORM.
DB_DSN=spp:password@tcp(127.0.0.1:3306)/spp?charset=utf8mb4&parseTime=True&loc=Local

# Lokal memakai SQLite milik Laravel (gunakan path absolut):
# DB_DRIVER=sqlite
# DB_DSN=C:/Users/it/Documents/2.belajar_ai/spp/database/database.sqlite
# DB_AUTO_MIGRATE=true

# Jangan aktifkan di production; gunakan migrations/001_create_audit_logs.sql.
DB_AUTO_MIGRATE=false

# memory = satu instance / lokal; redis = wajib untuk multi-instance.
CACHE_DRIVER=redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# basic | pro. Tier pro membuka seluruh feature flag.
APP_TIER=basic
# Override feature flag, contoh: {"whatsapp_gateway":"basic"}
APP_FEATURES_JSON=

# Hanya percayai header X-Forwarded-For dari reverse proxy ini.
# Gunakan "none" bila aplikasi diekspos langsung tanpa proxy.
TRUSTED_PROXIES=127.0.0.1

RATE_LIMIT_LOGIN=5
RATE_LIMIT_RECEIPT=30
IDEMPOTENCY_TTL=30s

SERVER_READ_HEADER_TIMEOUT=10s
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=60s
SERVER_IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=20s
